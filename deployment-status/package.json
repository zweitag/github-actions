{
  "name": "deployment-status",
  "version": "0.1.0",
  "description": "Creates a GitHub Deployment Status",
  "private": true,
  "type": "module",
  "main": "lib/initial-status.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "package": "ncc build -o dist/initial-status src/initial-status.ts && ncc build -o dist/final-status src/final-status.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "pnpm run build && pnpm run format && pnpm run package && pnpm test"
  },
  "packageManager": "pnpm@12.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zweitag/github-actions.git"
  },
  "keywords": [
    "actions",
    "node",
    "deployment",
    "status"
  ],
  "author": "zweitag",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/types": "^18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
